#!/bin/sh
# 공개 저장소(홈페이지)에 비밀 키가 들어가는 커밋을 막는다 — 2026-10-10 레드팀.
# 사고: 2026-02~09 유튜브 키가 페이지 코드에 박혀 공개 기록에 남았다. 키는 GitHub Actions 비밀·환경변수에만 둔다.
# Supabase 공개(anon) 키는 원래 공개용이라 막지 않는다.
PAT='AIza[0-9A-Za-z_-]{35}|(^|[^A-Za-z0-9_-])(sk-ant-|sk-[A-Za-z0-9_-]{20,}|ntn_[A-Za-z0-9]{20,}|secret_[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|sb_secret_)|xox[bpa]-[0-9]+-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY'
if git diff --cached -U0 --no-color -- . ':(exclude).githooks/pre-commit' | grep -E '^\+' | grep -qE "$PAT"; then
  echo "커밋 막음: 비밀 키처럼 보이는 문자열이 있습니다. 이 저장소는 공개입니다 — 키는 GitHub Actions 비밀이나 환경변수에 두세요."
  exit 1
fi
